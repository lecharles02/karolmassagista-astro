function updateWhatsappLinks(html: string, route: string, text: string) {
  const encodedText = encodeURIComponent(text);
  const label = route === "/" ? "home" : route.replaceAll("/", "_").replace(/^_|_$/g, "");
  const href = `https://wa.me/5519983732331?text=${encodedText}&utm_source=site&utm_medium=whatsapp&utm_campaign=${encodeURIComponent(label)}`;

  return html.replace(/href="https:\/\/wa\.me\/5519983732331[^"]*"/g, `href="${href}"`);
}

function updateCtaLabels(html: string) {
  return html
    .replace(/>Agendar Agora</g, ">Consultar horários<")
    .replace(/>Agendar</g, ">Consultar horários<")
    .replace(/>AGENDAR</g, ">CONSULTAR HORÁRIOS<")
    .replace(/>agendar</g, ">consultar horários<")
    .replace(/Agendar no Cambu[^<"]*/g, "Consultar horários")
    .replace(/Agende pelo WhatsApp/g, "Consulte horários pelo WhatsApp")
    .replace(/Agende agora/g, "Consulte horários");
}

function replaceTitle(html: string, title: string) {
  const escaped = escapeHtml(title);
  return html
    .replace(/<title>.*?<\/title>/i, `<title>${escaped}</title>`)
    .replace(/<meta property="og:title" content="[^"]*"/i, `<meta property="og:title" content="${escaped}"`)
    .replace(/<meta name="twitter:title" content="[^"]*"/i, `<meta name="twitter:title" content="${escaped}"`);
}

function replaceDescription(html: string, description: string) {
  const escaped = escapeHtml(description);
  return html
    .replace(/<meta name="description" content="[^"]*"/i, `<meta name="description" content="${escaped}"`)
    .replace(/<meta property="og:description" content="[^"]*"/i, `<meta property="og:description" content="${escaped}"`)
    .replace(/<meta name="twitter:description" content="[^"]*"/i, `<meta name="twitter:description" content="${escaped}"`);
}

function ensureSocialMetadata(html: string) {
  const title = html.match(/<title>([^<]*)<\/title>/i)?.[1] ?? "Karol Massagista";
  const description = html.match(/<meta name="description" content="([^"]*)"/i)?.[1] ?? "";
  const image = html.match(/<meta property="og:image" content="([^"]*)"/i)?.[1]
    ?? "https://karolmassagista.com.br/imagens/hero/karol-massagista-tantrica-hero-campinas-v2.webp";
  const missing: string[] = [];

  if (!/<meta property="og:image"/i.test(html)) missing.push(`<meta property="og:image" content="${image}">`);
  if (!/<meta property="og:image:width"/i.test(html)) missing.push('<meta property="og:image:width" content="387">');
  if (!/<meta property="og:image:height"/i.test(html)) missing.push('<meta property="og:image:height" content="514">');
  if (!/<meta property="og:image:alt"/i.test(html)) missing.push('<meta property="og:image:alt" content="Karol Massagista em Campinas">');
  if (!/<meta name="twitter:card"/i.test(html)) missing.push('<meta name="twitter:card" content="summary_large_image">');
  if (!/<meta name="twitter:title"/i.test(html)) missing.push(`<meta name="twitter:title" content="${title}">`);
  if (!/<meta name="twitter:description"/i.test(html)) missing.push(`<meta name="twitter:description" content="${description}">`);
  if (!/<meta name="twitter:image"/i.test(html)) missing.push(`<meta name="twitter:image" content="${image}">`);

  return html
    .replace(/(<meta property="og:image:width" content=")[^"]*/i, (_match, prefix) => `${prefix}387`)
    .replace(/(<meta property="og:image:height" content=")[^"]*/i, (_match, prefix) => `${prefix}514`)
    .replace("</head>", `${missing.join("")}</head>`);
}

function replaceCanonical(html: string, route: string) {
  return html.replace(/<link rel="canonical" href="[^"]*"/i, `<link rel="canonical" href="https://karolmassagista.com.br${route}"`);
}

function replaceOgUrl(html: string, route: string) {
  return html.replace(/<meta property="og:url" content="[^"]*"/i, `<meta property="og:url" content="https://karolmassagista.com.br${route}"`);
}

function applyIndexingRules(html: string, route: string) {
  if (route !== "/404/") return html;

  if (/<meta name="robots" content="[^"]*"/i.test(html)) {
    return html.replace(/<meta name="robots" content="[^"]*"/i, '<meta name="robots" content="noindex, follow"');
  }

  return html.replace("</head>", '<meta name="robots" content="noindex, follow"></head>');
}

