function normalizeInternalLinks(html: string) {
  return html.replaceAll('href="/massagista-em-campinas/"', 'href="/"').replace(/href="\/([^"#?]*)(([#?][^"]*)?)"/g, (match, pathPart: string, suffix: string) => {
    if (!pathPart || pathPart.endsWith("/") || pathPart.includes(".") || pathPart.startsWith("_astro/")) {
      return match;
    }
    return `href="/${pathPart}/${suffix}"`;
  });
}

