function replaceEditorialPlaceholders(html: string, route: string) {
  const replacements = editorialContent[route];
  if (!replacements) return html;

  let index = 0;
  return html.replace(/\[CONTEÚDO:[\s\S]*?\]/g, () => replacements[index++] ?? "");
}

function enhanceLegacyHtml(rawHtml: string, route: string) {
  const config = commercialPages[route];
  let output = replaceEditorialPlaceholders(rawHtml, route);

  output = optimizePerformance(output);
  output = normalizeHeadingSemantics(output);
  output = promoteGalleryPhoto(output);
  output = injectClimateControlledCopy(output, route);
  output = injectBrandLogo(output, route);
  output = injectAboutSection(output, route);
  output = refineLocalPageStructure(output, route);
  output = refineRegionalLandingCopy(output, route);
  output = normalizeInternalLinks(output);
  const localConfig = localLandingPages[route];
  output = updateWhatsappLinks(output, route, config?.whatsappText ?? localConfig?.whatsappText ?? getDefaultWhatsappText(route));
  output = updateCtaLabels(output);
  output = replaceCanonical(output, route);
  output = replaceOgUrl(output, route);
  output = applyIndexingRules(output, route);

  if (config) {
    output = replaceTitle(output, config.title);
    output = replaceDescription(output, config.description);
    output = injectJsonLd(output, buildServiceSchema(route, config));
    output = injectJsonLd(output, buildFaqSchema(config.faq));
    output = injectFaqSection(output, config.faq);
    output = injectCommercialDepthSection(output, route, config.serviceName);
  }

  if (localConfig) {
    output = replaceTitle(output, localConfig.title);
    output = replaceDescription(output, localConfig.description);
    output = injectLocalLandingSection(output, localConfig);
    output = injectJsonLd(output, buildLocalLandingSchema(route, localConfig));
  }

  const seoOverride = seoOverrides[route];
  if (seoOverride) {
    output = replaceTitle(output, seoOverride.title);
    output = replaceDescription(output, seoOverride.description);
  }

  if (route === "/servicos/") {
    output = injectServicesHubSection(output);
  }

  if (route === "/blog/") {
    output = injectBlogIndexLinks(output);
  }

  if (route.startsWith("/blog/") && route !== "/blog/") {
    if (!output.includes('"@type":"BlogPosting"')) {
      output = injectJsonLd(output, buildArticleSchema(output, route));
    }
    output = injectBlogRecoverySection(output, route);
  }

  output = injectJsonLd(output, buildBreadcrumbSchema(route));
  output = injectEnhancementStyles(output);
  output = injectConversionSection(output, route, config?.serviceName);
  output = injectMobileWhatsappBar(output, route, config?.serviceName);
  output = sanitizeStructuredData(output);
  output = ensureSocialMetadata(output);
  output = addImageDimensions(output);
  output = injectLightweightInteractions(output);
  output = moveStructuredDataToBodyEnd(output);

  return output;
}

function moveStructuredDataToBodyEnd(html: string) {
  const headEnd = html.indexOf("</head>");
  if (headEnd < 0) return html;

  const head = html.slice(0, headEnd);
  const body = html.slice(headEnd);
  const scripts: string[] = [];
  const cleanedHead = head.replace(/<script[^>]+type=["']application\/ld\+json["'][^>]*>[\s\S]*?<\/script>/g, (script) => {
    scripts.push(script);
    return "";
  });

  if (scripts.length === 0) return html;
  return `${cleanedHead}${body.replace("</body>", `${scripts.join("")}</body>`)}`;
}

function optimizePerformance(html: string) {
  return html
    .replace(/@font-face\{[^}]*src:url\(['"]?\/fonts\/(?:Montserrat-Bold|Poppins-Light|Poppins-Medium|Poppins-Bold)\.woff2['"]?\)[^}]*\}/g, "")
    .replace(/<astro-island\b(?=[^>]*component-url="\/_astro\/(?:Navbar|HeroSection|GallerySection|FullGallery|WhatsAppFloat|SpaceSection|TestimonialsSection|FAQSection|SiloLinks)[^"]+")[^>]*>([\s\S]*?)(?:<!--astro:end-->)?<\/astro-island>/g, "$1")
    .replace(/<astro-island\b(?=[^>]*component-url="\/_astro\/(?:toaster|sonner)[^"]+")[^>]*>[\s\S]*?(?:<!--astro:end-->)?<\/astro-island>/g, "")
    .replace(/<style>astro-island,astro-slot,astro-static-slot\{display:contents\}<\/style>/g, "")
    .replace(/<script>([\s\S]*?)<\/script>/g, (script, content) => {
      if (content.includes('customElements.define("astro-island"') || content.includes("self.Astro") || content.includes('new Event("astro:')) return "";
      return script;
    })
    .replace(/<img([^>]*?)\/\s+(fetchpriority|loading)=/g, "<img$1 $2=")
    .replace(/<img([^>]*?)\/\s+fetchpriority="high">/g, '<img$1 fetchpriority="high" decoding="async">')
    .replace(/background-image:url\(&#x27;https:\/\/user-images\.githubusercontent\.com\/15075759\/28719144-86dc0f70-73b1-11e7-911d-60d70fcded21\.png&#x27;\)/g, "background-image:radial-gradient(circle at 1px 1px,rgba(17,27,33,.16) 1px,transparent 0);background-size:18px 18px")
    .replace(/poster="\/imagens\/galeria\/video-massagem-campinas\.mp4#t=0\.001"/g, 'poster="/imagens/galeria/experiencia-sensorial-massagem-campinas.webp"')
    .replace(/(<video\b[^>]*?)preload="auto"/g, '$1preload="none"')
    .replace(/<link rel="preload" as="font" href="\/fonts\/(?:Montserrat-Bold|Poppins-Bold)\.woff2" type="font\/woff2" crossorigin>/g, "")
    .replace(/<link rel="preload" href="([^"]+\.css)" as="style" onload="this\.onload=null;this\.rel='stylesheet'"><noscript><link rel="stylesheet" href="\1"><\/noscript>/g, (_match, href: string) => inlineLegacyStylesheet(href));
}

function inlineLegacyStylesheet(href: string) {
  const stylesheetPath = path.resolve(process.cwd(), "public", href.replace(/^\//, ""));
  if (!fs.existsSync(stylesheetPath)) return `<link rel="stylesheet" href="${href}">`;
  const stylesheet = fs.readFileSync(stylesheetPath, "utf8").replace(
    /@font-face\{[^}]+src:url\(\/fonts\/(?:Montserrat-Bold|Poppins-Light|Poppins-Medium|Poppins-Bold)\.woff2\)[^}]*\}/g,
    ""
  );
  return `<style data-critical-legacy-css>${stylesheet}</style>`;
}

