    },
  ];

  if (parts.length > 0) {
    itemListElement.push({
      "@type": "ListItem",
      position: 2,
      name: titleFromSlug(parts.at(-1) ?? ""),
      item: `https://karolmassagista.com.br${route}`,
    });
  }

  return {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement,
  };
}

function buildLocalLandingSchema(route: string, config: (typeof localLandingPages)[string]) {
  return {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `https://karolmassagista.com.br${route}#webpage`,
    name: config.title,
    description: config.description,
    url: `https://karolmassagista.com.br${route}`,
    about: {
      "@type": "HealthAndBeautyBusiness",
      "@id": "https://karolmassagista.com.br/#business",
      name: "Karol Massagista",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Campinas",
        addressRegion: "SP",
        addressCountry: "BR",
      },
    },
    inLanguage: "pt-BR",
  };
}

function buildArticleSchema(html: string, route: string) {
  const title = getMetaValue(html, /<title>(.*?)<\/title>/i);
  const description = getMetaValue(html, /<meta name="description" content="([^"]*)"/i);
  const canonical = getMetaValue(html, /<link rel="canonical" href="([^"]*)"/i) || `https://karolmassagista.com.br${route}`;

  return {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: stripHtml(title),
    description: stripHtml(description),
    mainEntityOfPage: canonical,
    author: {
      "@type": "Person",
      name: "Karol Massagista",
    },
    publisher: {
      "@type": "Organization",
      name: "Karol Massagista",
      url: "https://karolmassagista.com.br/",
    },
    inLanguage: "pt-BR",
  };
}

function getMetaValue(html: string, pattern: RegExp) {
  return pattern.exec(html)?.[1] ?? "";
}

function stripHtml(value: string) {
  return value.replace(/<[^>]*>/g, "").trim();
}

function titleFromSlug(slug: string) {
  return slug
    .split("-")
    .filter(Boolean)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(" ");
}

function escapeHtml(value: string) {
  return value
    .replaceAll("&", "&amp;")
    .replaceAll('"', "&quot;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;");
}

function enhanceHomePage(html: string) {
  let output = html
    .replace(
      /<h1 id="home-hero-title">[\s\S]*?<\/h1>/,
      '<h1 id="home-hero-title">Procurando uma massagem tântrica em <span>Campinas?</span></h1>'
