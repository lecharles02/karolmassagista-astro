  const media = content ? `<figure class="seo-depth__media"><img src="${content.image}" alt="${escapeHtml(content.imageAlt)}" loading="lazy" decoding="async"><figcaption>Ambiente e experiência de atendimento no Cambuí, em Campinas.</figcaption></figure>` : "";
