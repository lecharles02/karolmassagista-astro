function getRelatedServiceLinks(route: string) {
  const lower = route.toLowerCase();
  const links: string[][] = [];
  if (lower.includes("nuru")) links.push(["/massagem-nuru-campinas/", "Massagem Nuru em Campinas"]);
  if (lower.includes("lingam") || lower.includes("prostatica") || lower.includes("performance")) links.push(["/massagem-lingam-campinas/", "Massagem Lingam em Campinas"]);
  if (lower.includes("sensual") || lower.includes("casais") || lower.includes("erotica")) links.push(["/massagem-sensual-campinas/", "Massagem Sensual em Campinas"]);
  if (lower.includes("tantra") || lower.includes("tantrica") || lower.includes("yoga")) links.push(["/massagem-tantrica-campinas/", "Massagem Tântrica em Campinas"]);
  links.push(["/servicos/", "Comparar todos os serviços"]);
  return links.map(([href, label]) => `<a href="${href}">${label}</a>`).join("");
}

