    );

  output = output.replace(
    /<svg\b[^>]*class="[^"]*lucide-message-square[^"]*"[^>]*>[\s\S]*?<\/svg>(?=<svg viewBox="0 0 24 24" class="h-5 w-5 fill-current")/,
    ""
  );

  const galleryPattern = /<section id="galeria"[\s\S]*?<\/section>/;
  const gallery = `<section id="galeria" class="py-24 bg-cream-100 relative overflow-hidden"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10"><header class="text-center mb-16"><span class="text-brand font-bold tracking-widest uppercase text-xs mb-3 block">Galeria profissional</span><h2 class="font-montserrat font-black text-4xl md:text-5xl text-stone-900 mb-6 tracking-tight">Conheça um pouco mais da Karol</h2><p class="font-poppins text-stone-500 text-base max-w-2xl mx-auto">Confira alguns registros compartilhados pela Karol. O atendimento acontece em ambiente privativo no Cambuí, em Campinas.</p><div class="w-16 h-[2px] bg-brand/30 mx-auto rounded-full mt-6"></div></header><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-7">${[
    ["karol-galeria-01.webp", "Karol em uma poltrona junto à janela durante uma viagem"],
    ["karol-galeria-02.webp", "Karol sentada junto à janela com vista para a paisagem"],
    ["karol-galeria-03.webp", "Retrato de Karol em uma poltrona vermelha"],
    ["karol-galeria-04.webp", "Karol em roupa esportiva vermelha na academia"],
  ].map(([file, alt]) => `<figure class="aspect-[3/4] rounded-[2rem] overflow-hidden shadow-soft border-4 border-white group"><img src="/imagens/galeria/${file}" alt="${alt}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async" width="1000" height="1400"></figure>`).join("")}</div><div class="text-center mt-12"><a href="/galeria/" class="inline-flex items-center gap-3 bg-white text-stone-900 font-montserrat font-bold py-4 px-8 rounded-full shadow-soft border border-stone-100 hover:bg-brand hover:text-white transition-colors">Ver galeria completa<span aria-hidden="true">→</span></a></div></div></section>`;
  output = output.replace(galleryPattern, gallery);

  const servicesPattern = /<section id="servicos"[\s\S]*?<\/section>/;
  const servicesMatch = output.match(servicesPattern);
  if (servicesMatch) {
    output = output.replace(servicesPattern, "");
    output = output.replace(galleryPattern, `${servicesMatch[0]} ${gallery}`);
  }

  const reviewSectionPattern = /<section id="depoimentos"[\s\S]*?<\/section>/;
  const reviewSection = `<section id="depoimentos" class="py-24 bg-[#edf5f3] relative"><div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8"><header class="text-center mb-12"><span class="text-brand font-bold tracking-widest uppercase text-xs mb-3 block">Prova social</span><h2 class="font-montserrat font-black text-3xl md:text-5xl text-stone-900 tracking-tight">Opiniões de clientes no Google</h2></header><div class="max-w-4xl mx-auto rounded-3xl bg-white border border-stone-200 shadow-sm p-6 md:p-9 flex flex-col md:flex-row items-center justify-between gap-6"><div class="flex items-center gap-5"><span class="grid place-items-center w-14 h-14 rounded-full border border-stone-200 text-3xl font-bold" aria-hidden="true"><span style="background:conic-gradient(from -45deg,#4285f4 0 25%,#34a853 25% 50%,#fbbc05 50% 75%,#ea4335 75%);color:transparent;background-clip:text">G</span></span><div><h3 class="font-montserrat font-bold text-lg text-stone-900">Karol Massagista</h3><a class="text-sm text-stone-600 underline underline-offset-4 hover:text-brand" href="https://share.google/6Wjq6Qx3XE8okqrHv" target="_blank" rel="noopener noreferrer">Ver perfil e opiniões no Google</a></div></div><div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto"><a class="inline-flex justify-center items-center rounded-full bg-white border border-stone-300 px-6 py-3 font-semibold text-stone-800 hover:bg-stone-50" href="https://share.google/6Wjq6Qx3XE8okqrHv" target="_blank" rel="noopener noreferrer">Ver perfil no Google</a><a class="inline-flex justify-center items-center rounded-full bg-brand px-6 py-3 font-semibold text-white hover:bg-brand-dark" href="https://g.page/r/CXaXmEp3QyR6EBM/review" target="_blank" rel="noopener noreferrer">Avaliar no Google</a></div></div><p class="mt-6 text-center text-sm text-stone-500">Leia as avaliações diretamente no Google e, se já conhece o atendimento, compartilhe sua experiência.</p></div></section>`;
  const reviewCards = `<div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-8"><article class="rounded-2xl bg-white border border-stone-200 p-6 shadow-sm"><div class="text-amber-500 tracking-[.18em]" aria-label="5 de 5 estrelas">★★★★★</div><blockquote class="mt-4 text-stone-700 leading-relaxed">“Ambiente seguro e muito bem localizado, tudo organizado e acolhedor.”</blockquote><p class="mt-5 text-xs font-semibold uppercase tracking-wider text-stone-500">Avaliação pública no Google</p></article><article class="rounded-2xl bg-white border border-stone-200 p-6 shadow-sm"><div class="text-amber-500 tracking-[.18em]" aria-label="5 de 5 estrelas">★★★★★</div><blockquote class="mt-4 text-stone-700 leading-relaxed">“Uma forma de renovar nosso relacionamento... Ele elogiou bastante o atendimento da Karol.”</blockquote><p class="mt-5 text-xs font-semibold uppercase tracking-wider text-stone-500">Avaliação pública no Google</p></article><article class="rounded-2xl bg-white border border-stone-200 p-6 shadow-sm"><div class="text-amber-500 tracking-[.18em]" aria-label="5 de 5 estrelas">★★★★★</div><blockquote class="mt-4 text-stone-700 leading-relaxed">“A massagem foi sensacional, a melhor que eu já fiz.”</blockquote><p class="mt-5 text-xs font-semibold uppercase tracking-wider text-stone-500">Avaliação pública no Google</p></article></div>`;
  const reviewSectionWithCards = reviewSection
    .replace('</a></div></div><div class="flex flex-col sm:flex-row', '</a><p class="mt-2 font-semibold text-amber-600"><span aria-hidden="true">★★★★★</span> 5,0 <span class="text-stone-500 font-normal">· 16 avaliações</span></p></div></div><div class="flex flex-col sm:flex-row')
    .replace('</div><p class="mt-6 text-center text-sm text-stone-500">', `</div>${reviewCards}<p class="mt-6 text-center text-sm text-stone-500">`);
  output = output.replace(reviewSectionPattern, reviewSectionWithCards);

  return output;
}

let html = enhanceLegacyHtml(sourceHtml, routePath);
