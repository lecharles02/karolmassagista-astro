function addImageDimensions(html: string) {
  return html.replace(/<img\b[^>]*>/g, (tag) => {
    const source = tag.match(/\bsrc=["']([^"'?]+)/)?.[1];
    const dimensions = source ? imageDimensions[source] : undefined;
    let output = tag;
    if (dimensions && !/\bwidth=/.test(output)) output = output.replace("<img", `<img width="${dimensions[0]}"`);
    if (dimensions && !/\bheight=/.test(output)) output = output.replace("<img", `<img height="${dimensions[1]}"`);
    if (!/\bdecoding=/.test(output)) output = output.replace("<img", '<img decoding="async"');
    return output;
  });
}

function sanitizeStructuredData(html: string) {
  const currentTitle = stripHtml(getMetaValue(html, /<title>(.*?)<\/title>/i));
  const currentDescription = stripHtml(getMetaValue(html, /<meta name="description" content="([^"]*)"/i));
  const currentCanonical = getMetaValue(html, /<link rel="canonical" href="([^"]*)"/i);

  return html.replace(/(<script[^>]+type=["']application\/ld\+json["'][^>]*>)([\s\S]*?)(<\/script>)/g, (full, opening, json, closing) => {
    try {
      const data = JSON.parse(json);
      normalizeStructuredDataUrls(data);
      const objects = Array.isArray(data) ? data : [data];
      if (objects.some((object) => object?.["@type"] === "AggregateRating")) return "";
      for (const object of objects) {
        const types = Array.isArray(object?.["@type"]) ? object["@type"] : [object?.["@type"]];
        if (types.includes("WebPage")) {
          object.name = currentTitle;
          object.description = currentDescription;
          object.url = currentCanonical;
        }
        if (types.includes("BlogPosting") || types.includes("Article")) {
          object.headline = currentTitle;
          object.description = currentDescription;
          object.url = currentCanonical;
          if (typeof object.mainEntityOfPage === "string") object.mainEntityOfPage = currentCanonical;
          if (object.mainEntityOfPage?.["@id"]) object.mainEntityOfPage["@id"] = currentCanonical;
        }
        if (!types.includes("LocalBusiness")) continue;
        delete object.aggregateRating;
        if (Array.isArray(object.sameAs)) object.sameAs = object.sameAs.filter((url: string) => !url.includes("wa.me/"));
        if (object.address?.streetAddress === "Campinas Cambuí - Região Central") {
          delete object.address.streetAddress;
          delete object.address.postalCode;
        }
      }
      return `${opening}${JSON.stringify(data)}${closing}`;
    } catch {
      return full;
    }
  });
}

function normalizeStructuredDataUrls(value: unknown): void {
  if (Array.isArray(value)) {
    value.forEach(normalizeStructuredDataUrls);
    return;
  }
  if (!value || typeof value !== "object") return;

  for (const [key, child] of Object.entries(value)) {
    if (typeof child === "string" && child.startsWith("https://karolmassagista.com.br")) {
      const [base, hash = ""] = child.split("#", 2);
      const parsed = new URL(base);
      if (parsed.pathname !== "/" && !parsed.pathname.endsWith("/") && !/\.[a-z0-9]+$/i.test(parsed.pathname)) {
        parsed.pathname = `${parsed.pathname}/`;
      }
      (value as Record<string, unknown>)[key] = `${parsed.toString()}${hash ? `#${hash}` : ""}`;
      continue;
    }
    normalizeStructuredDataUrls(child);
  }
}

function injectLightweightInteractions(html: string) {
  if (html.includes("data-lightweight-interactions")) return html;
  const interactiveHtml = html.replace(
    /<button([^>]*)>((?:(?!<\/button>)[\s\S])*)<\/button><div class="([^"]*max-h-0[^"]*)">/g,
    '<button$1 type="button" aria-expanded="false" onclick="window.toggleLegacyFaq(this)">$2</button><div class="$3">'
  );
  return interactiveHtml.replace(
    "</body>",
    `<script data-lightweight-interactions>
      window.toggleLegacyFaq=button=>{
        const answer=button.nextElementSibling;
        if(!answer)return;
        const expanded=button.getAttribute("aria-expanded")==="true";
        button.setAttribute("aria-expanded",String(!expanded));
        answer.style.maxHeight=expanded?"0px":answer.scrollHeight+"px";
        answer.classList.toggle("opacity-0",expanded);
      };
      document.addEventListener("DOMContentLoaded",()=>{
        const openButton=document.querySelector('[aria-label="Abrir menu"]');
        const menu=openButton?.closest("nav")?.querySelector(".fixed.inset-0");
        const closeButton=menu?.querySelector("button");
        const toggleMenu=(open)=>{if(!menu)return;menu.classList.toggle("translate-x-full",!open);document.body.style.overflow=open?"hidden":"";openButton?.setAttribute("aria-expanded",String(open));};
        openButton?.setAttribute("aria-expanded","false");
        closeButton?.setAttribute("aria-label","Fechar menu");
        openButton?.addEventListener("click",()=>toggleMenu(true));
        closeButton?.addEventListener("click",()=>toggleMenu(false));
        menu?.querySelectorAll("a").forEach(link=>link.addEventListener("click",()=>toggleMenu(false)));
      });
    </script></body>`
  );
}

